# Copy to .env for local testing (do not commit .env — it's already in .gitignore).
# These are also set as GitHub Secrets for the Actions workflow.

BINANCE_SQUARE_OPENAPI_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional failure alerts. Only the GitHub Actions workflow reads these (a
# "Notify on failure" step), so they do nothing for local runs. Set them as
# GitHub Secrets, both or neither. Create the bot with @BotFather; get the
# chat id by messaging the bot, then opening getUpdates for it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: extra bStocks beyond the built-in list, "SYMBOL=Name" pairs.
BSTOCKS_EXTRA=

# Optional: "on" lets some themes mention a recent headline (outlet named, no links).
NEWS_CONTEXT=
